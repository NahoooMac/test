# Copy to apps/api/.env and fill in locally. Never commit .env.

NODE_ENV=development
HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# Public origin of the web app (used for CSRF origin checks and cookies). In production this must
# be exactly the https address people open, e.g. https://app.example.et — no trailing slash.
APP_ORIGIN=http://localhost:5173

# Production: serve the built web app from the API (one origin). Path to apps/web/dist.
WEB_DIST_DIR=
# Reverse proxies to believe for the client IP: hop count, "false", or proxy IPs/CIDRs.
# Unset = 1 in production (one proxy in front), none in development. Never "true".
TRUST_PROXY=

# Leave DATABASE_URL empty to use the embedded local Postgres (PGlite) in .data/pglite.
# For Neon, use the POOLED connection string of a DEVELOPMENT branch — never the main branch.
DATABASE_URL=
# Direct (non-pooled) connection string, used only by the migration CLI.
DATABASE_URL_DIRECT=
# Migrations against a remote database are refused unless this is set for that run.
ALLOW_REMOTE_MIGRATIONS=false

# SMS: console (dev only, prints to terminal) | afromessage (Phase 3)
SMS_PROVIDER=console

# AfroMessage (only when SMS_PROVIDER=afromessage). Token from the AfroMessage dashboard.
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER=
# Maximum OTP SMS sends per UTC day across all users.
SMS_DAILY_BUDGET=500

# Keyed hash for OTP codes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# OTP_HMAC_SECRET=   (leave unset in development to use the dev default)

# Yandex (server-side only; never sent to the browser). Without them a small offline place list is used.
YANDEX_GEOCODER_KEY=
YANDEX_GEOSUGGEST_KEY=
