{
  "name": "@dp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:local": "tsx watch --clear-screen=false src/server.ts --local-db",
    "dev:demo": "tsx watch --clear-screen=false src/server.ts --local-db --demo",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=ExperimentalWarning src/db/migrate-cli.ts",
    "admin:password": "node --disable-warning=ExperimentalWarning src/db/admin-password-cli.ts",
    "admin:grant":"node --disable-warning=ExperimentalWarning src/db/grant-admin-cli.ts",
    "sms:check": "node --disable-warning=ExperimentalWarning src/integrations/sms/check-cli.ts",
    "preview": "node --disable-warning=ExperimentalWarning src/server.ts --local-db --serve-web"
  },
  "dependencies": {
    "@dp/shared": "*",
    "@electric-sql/pglite": "^0.3.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.1.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
