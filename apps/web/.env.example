# Copy to apps/web/.env.local. These are baked into the built JavaScript at `npm run build`,
# so they are public by design — never put a secret here.

# Product name shown in the apps (not final).
VITE_APP_NAME=Courier
# Yandex Maps JS API v2.1 key (browser key; restrict it to your domain in the Yandex console).
VITE_YANDEX_JS_KEY=
